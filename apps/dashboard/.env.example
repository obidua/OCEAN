# =============================================
# RPC CONFIGURATION - NETWORK ENDPOINTS
# =============================================
# Main RPC - Primary network endpoint
VITE_RPC_URL=https://blockchain2.ramestta.com

# Fallback RPCs - Backup network endpoints (in order of preference)
VITE_RPC_URL_2=https://blockchain2.ramestta.com
# VITE_RPC_URL_3=https://blockchain3.ramestta.com
# VITE_RPC_URL_4=https://blockchain4.ramestta.com
# VITE_RPC_URL_5=https://backup-rpc.ramestta.com

# NOTE: Contact Ramestta team to get additional RPC endpoints
# More RPCs = Faster loading + Better reliability

# Network Configuration
VITE_CHAIN_ID=1370
VITE_NETWORK_NAME=Ramestta

# =============================================
# API KEYS & SECRETS (DO NOT COMMIT REAL VALUES)
# =============================================
# WalletConnect Project ID (get from https://cloud.walletconnect.com)
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

